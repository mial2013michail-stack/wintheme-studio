<Window x:Class="WinThemeStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinTheme Studio"
        Width="1280"
        Height="840"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BgSoftBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="6,0,0,30">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentGradient}">
                        <Path Data="M 12,2 C 13,7 14.6,8.6 19,9.5 C 14.6,10.4 13,12 12,17 C 11,12 9.4,10.4 5,9.5 C 9.4,8.6 11,7 12,2 Z"
                              Fill="#FFFFFF" Stretch="Uniform" Width="21" Height="21" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WinTheme" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="S T U D I O" FontSize="9.5" Foreground="{StaticResource DimBrush}"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="Н А С Т Р О Й К И" Style="{StaticResource Caption}"
                               Margin="12,0,0,8" />

                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Tag="dashboard" Checked="Nav_Checked" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M 4,4 L 10,4 L 10,10 L 4,10 Z M 14,4 L 20,4 L 20,10 L 14,10 Z M 4,14 L 10,14 L 10,20 L 4,20 Z M 14,14 L 20,14 L 20,20 L 14,20 Z" />
                            <TextBlock Text="Обзор" Margin="11,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavProfiles" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Tag="profiles" Checked="Nav_Checked" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M 12,3 L 21,8 L 12,13 L 3,8 Z M 3,12 L 12,17 L 21,12 M 3,16 L 12,21 L 21,16" />
                            <TextBlock Text="Профили" Margin="11,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Tag="appearance" Checked="Nav_Checked" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M 4,6 L 20,6 M 4,12 L 20,12 M 4,18 L 20,18 M 9,6 A 2.2,2.2 0 1 0 9,6.1 M 16,12 A 2.2,2.2 0 1 0 16,12.1 M 7,18 A 2.2,2.2 0 1 0 7,18.1" />
                            <TextBlock Text="Внешний вид" Margin="11,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavExplorer" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Tag="explorer" Checked="Nav_Checked" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M 3,6 L 9,6 L 11,8 L 21,8 L 21,19 L 3,19 Z" />
                            <TextBlock Text="Проводник" Margin="11,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavIcons" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Tag="icons" Checked="Nav_Checked" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M 12,3 L 14.7,9.3 L 21.5,10 L 16.4,14.6 L 17.9,21.3 L 12,18 L 6.1,21.3 L 7.6,14.6 L 2.5,10 L 9.3,9.3 Z" />
                            <TextBlock Text="Иконки" Margin="11,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavDock" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Tag="dock" Checked="Nav_Checked" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M 3,13 L 21,13 L 21,20 L 3,20 Z M 7,16.5 L 7,16.6 M 12,16.5 L 12,16.6 M 17,16.5 L 17,16.6 M 7,5 L 17,5 M 12,5 L 12,9" />
                            <TextBlock Text="Док" Margin="11,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavRestore" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Tag="restore" Checked="Nav_Checked" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M 4,12 A 8,8 0 1 0 12,4 M 12,4 L 12,8 M 12,4 L 8.5,7" />
                            <TextBlock Text="Восстановление" Margin="11,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Tag="about" Checked="Nav_Checked" Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M 12,3 A 9,9 0 1 0 12,21 A 9,9 0 1 0 12,3 M 12,10 L 12,17 M 12,7 L 12,7.1" />
                            <TextBlock Text="О программе" Margin="11,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource CardTight}" Background="#0DFFFFFF" Padding="13">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round"
                                  Stroke="{StaticResource SuccessBrush}"
                                  Data="M 12,3 L 20,6 L 20,11 C 20,16 16,19 12,21 C 8,19 4,16 4,11 L 4,6 Z M 8.5,12 L 11,14.5 L 15.5,9.5" />
                            <TextBlock Text="Всё обратимо" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="Перед каждым изменением создаётся резервная копия."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="VersionLabel" Text="v1.0.0" Style="{StaticResource Caption}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="34,24,34,14">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Обзор" Style="{StaticResource H1}" />
                    <TextBlock x:Name="PageSubtitle" Text="Состояние оформления и быстрые действия"
                               Style="{StaticResource Muted}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Grid Width="246" Margin="0,0,14,0">
                        <TextBox x:Name="SettingsSearch" Style="{StaticResource TextBoxStyle}" Padding="31,8,11,8"
                                 ToolTip="Поиск по настройкам: обои, значки, Проводник, откат…"
                                 TextChanged="SettingsSearch_TextChanged" KeyDown="SettingsSearch_KeyDown" />
                        <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{StaticResource MutedBrush}" IsHitTestVisible="False"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0"
                              Data="M 10,4 A 6,6 0 1 0 10,16 A 6,6 0 1 0 10,4 M 14.5,14.5 L 19,19" />
                        <TextBlock x:Name="SearchHint" Text="Поиск настроек" IsHitTestVisible="False"
                                   Foreground="{StaticResource DimBrush}" FontSize="12.5"
                                   VerticalAlignment="Center" Margin="31,0,0,0" />
                    </Grid>
                    <Border Style="{StaticResource Pill}" Background="{StaticResource SuccessSoftBrush}"
                            BorderBrush="#3045D6A0" Padding="11,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Безопасный режим" FontSize="12" Foreground="#9BE9CB" Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SettingsSearch}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="#FF151A24" BorderBrush="{StaticResource StrokeStrongBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,6,0,0" Width="380"
                            MaxHeight="380">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="SearchResults" />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>

            <ScrollViewer Grid.Row="1" x:Name="PageScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="34,0,26,18">
                <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" />
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0"
                    Background="#08000000">
                <Grid Margin="34,0,34,0" Height="54">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round"
                              Stroke="{StaticResource MutedBrush}"
                              Data="M 12,3 L 20,6 L 20,11 C 20,16 16,19 12,21 C 8,19 4,16 4,11 L 4,6 Z" />
                        <TextBlock Text="Только параметры пользователя. Системные файлы не изменяются."
                                   Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ChangesLabel" Text="Изменений нет" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button Content="Перезапустить Проводник" Style="{StaticResource SmallButton}"
                                Click="RestartExplorer_Click" Margin="0,0,8,0" />
                        <Button x:Name="UndoButton" Content="Отменить всё" Style="{StaticResource SmallButton}"
                                Click="UndoAll_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="Toast" Panel.ZIndex="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,28,72" Background="#F21A1F2B" BorderBrush="{StaticResource StrokeStrongBrush}"
                BorderThickness="1" CornerRadius="12" Padding="14,10" Opacity="0" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="ToastDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="ToastText" Text="" FontSize="13" Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
