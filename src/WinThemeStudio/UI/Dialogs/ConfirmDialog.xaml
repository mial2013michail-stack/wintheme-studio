<Window x:Class="WinThemeStudio.UI.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinTheme Studio"
        Width="480"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Border Margin="22"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource StrokeStrongBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="26"
            MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="10" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBox"
                        Width="44" Height="44"
                        CornerRadius="13"
                        Background="{StaticResource WarningSoftBrush}"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="IconGlyph"
                               Text="!"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <TextBlock x:Name="TitleText" Style="{StaticResource H2}" Text="Подтверждение" />
                    <TextBlock x:Name="MessageText"
                               Style="{StaticResource Muted}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{StaticResource StrokeBrush}" Margin="0,22,0,18" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Style="{StaticResource GhostButton}"
                        Content="Отмена"
                        MinWidth="96"
                        IsCancel="True"
                        Margin="0,0,8,0"
                        Click="OnCancel" />
                <Button x:Name="ConfirmButton"
                        Style="{StaticResource PrimaryButton}"
                        Content="Продолжить"
                        MinWidth="128"
                        IsDefault="True"
                        Click="OnConfirm" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
