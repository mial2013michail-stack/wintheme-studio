<views:PageView xmlns:views="clr-namespace:WinThemeStudio.UI.Views" x:Class="WinThemeStudio.UI.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <StackPanel Margin="0,0,4,8">
        <Border Style="{StaticResource CardTight}" Background="#0E172033" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Параметры пользователя, без патчей" Style="{StaticResource SettingTitle}" />
                <TextBlock Text="Здесь меняются только документированные параметры HKCU. Некоторые изменения панели задач и Проводника применяются после перезапуска оболочки."
                           Style="{StaticResource SettingCaption}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border x:Name="RestartHint" Style="{StaticResource CardTight}" Background="#1AE95420" Margin="0,0,0,16"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="Нужен перезапуск Проводника" Style="{StaticResource SettingTitle}" />
                    <TextBlock Text="Панель задач, поиск и значки папок обновятся после перезапуска оболочки. Открытые окна Проводника закроются."
                               Style="{StaticResource SettingCaption}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Перезапустить" Style="{StaticResource SmallButton}"
                        VerticalAlignment="Center" Click="RestartHint_Click" />
            </Grid>
        </Border>

        <TextBlock Text="Панель задач" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <Border Style="{StaticResource SettingRow}" Background="#0AFFFFFF">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Центрировать значки" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Значки приложений по центру панели задач. Выключено — классическое расположение слева."
                                       Style="{StaticResource SettingCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox x:Name="TaskbarCenterToggle" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Click="TaskbarCenter_Click" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}" Background="#0AFFFFFF">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Показывать секунды" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Секунды в системных часах рядом с датой." Style="{StaticResource SettingCaption}" />
                        </StackPanel>
                        <CheckBox x:Name="SecondsToggle" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Click="Seconds_Click" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}" Background="#0AFFFFFF">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Виджеты" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Кнопка виджетов на панели задач." Style="{StaticResource SettingCaption}" />
                        </StackPanel>
                        <CheckBox x:Name="WidgetsToggle" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Click="Widgets_Click" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}" Background="#0AFFFFFF" Margin="0,0,0,12">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Чат Microsoft Teams" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Кнопка чата на панели задач, если она поддерживается системой."
                                       Style="{StaticResource SettingCaption}" />
                        </StackPanel>
                        <CheckBox x:Name="ChatToggle" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Click="Chat_Click" />
                    </Grid>
                </Border>

                <TextBlock Text="Кнопка поиска" Style="{StaticResource SettingTitle}" Margin="0,2,0,8" />
                <Border Style="{StaticResource SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SearchHidden" Style="{StaticResource SegmentItem}" GroupName="SearchMode"
                                     Content="Скрыть" Tag="0" Checked="Search_Checked" />
                        <RadioButton x:Name="SearchIcon" Style="{StaticResource SegmentItem}" GroupName="SearchMode"
                                     Content="Значок" Tag="1" Checked="Search_Checked" Margin="3,0,0,0" />
                        <RadioButton x:Name="SearchBox" Style="{StaticResource SegmentItem}" GroupName="SearchMode"
                                     Content="Поле" Tag="2" Checked="Search_Checked" Margin="3,0,0,0" />
                        <RadioButton x:Name="SearchBoxLabel" Style="{StaticResource SegmentItem}" GroupName="SearchMode"
                                     Content="Поле с подписью" Tag="3" Checked="Search_Checked" Margin="3,0,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="Проводник" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <Border Style="{StaticResource SettingRow}" Background="#0AFFFFFF">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Скрывать расширения файлов" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Стандартное поведение Windows. Выключите, чтобы видеть .exe, .pdf и другие расширения."
                                       Style="{StaticResource SettingCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox x:Name="HideExtensionsToggle" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Click="HideExtensions_Click" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}" Background="#0AFFFFFF">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Показывать скрытые файлы" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Отображать объекты с атрибутом «скрытый» в Проводнике."
                                       Style="{StaticResource SettingCaption}" />
                        </StackPanel>
                        <CheckBox x:Name="HiddenFilesToggle" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Click="HiddenFiles_Click" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}" Background="#0AFFFFFF" Margin="0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Компактный режим" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Меньше отступов между элементами списков и файлов."
                                       Style="{StaticResource SettingCaption}" />
                        </StackPanel>
                        <CheckBox x:Name="CompactModeToggle" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Click="CompactMode_Click" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}" Background="#0AFFFFFF">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Открывать «Этот компьютер»" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Проводник стартует с дисков, а не с раздела «Главная»."
                                       Style="{StaticResource SettingCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox x:Name="ThisPcToggle" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Click="ThisPc_Click" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}" Background="#0AFFFFFF" Margin="0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Полный путь в заголовке" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Показывать полный путь к папке в заголовке окна Проводника."
                                       Style="{StaticResource SettingCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox x:Name="FullPathToggle" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Click="FullPath_Click" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Text="Рабочий стол и меню" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <Border Style="{StaticResource SettingRow}" Background="#0AFFFFFF">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Показывать значки рабочего стола" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Скрывает или возвращает ярлыки, папки и корзину на рабочем столе."
                                       Style="{StaticResource SettingCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox x:Name="DesktopIconsToggle" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Click="DesktopIcons_Click" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}" Background="#0AFFFFFF" Margin="0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Классическое контекстное меню" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Возвращает полное меню Windows 10 вместо сокращённого меню Windows 11. Изменение обратимо."
                                       Style="{StaticResource SettingCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox x:Name="ClassicMenuToggle" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Click="ClassicMenu_Click" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="Перезапуск Проводника" Style="{StaticResource SettingTitle}" />
                    <TextBlock Text="Закроет все окна Проводника и заново запустит оболочку. Панель задач и рабочий стол вернутся через несколько секунд."
                               Style="{StaticResource SettingCaption}" TextWrapping="Wrap" MaxWidth="560"
                               HorizontalAlignment="Left" />
                </StackPanel>
                <Button Grid.Column="1" Content="Перезапустить" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="RestartExplorer_Click" />
            </Grid>
        </Border>
    </StackPanel>
</views:PageView>
